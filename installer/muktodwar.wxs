<?xml version="1.0" encoding="UTF-8"?>
<!--
  MuktoDwar - Windows Installer (MSI) package.

  This installer is the managed-deployment alternative to the Inno Setup
  package in installer/muktodwar.iss. Both are produced from the same
  application build and follow the same installation policy:

    * Application version .......... 1.1.2 (identical in both installers)
    * Install location ............. %ProgramFiles%\MuktoDwar
    * Start Menu shortcut ......... yes (identical name and target)
    * Desktop shortcut ............. yes (identical name and target)
    * Uninstaller ................... provided by Windows Installer, and
                                    registered in Add/Remove Programs
    * User data .................... kept on upgrade and on uninstall
                                    (configuration and DPAPI-encrypted keys
                                    live in %LOCALAPPDATA%\LocalAIGateway,
                                    outside the installation directory)

  The cabinet is embedded in the package so the .msi is a single,
  self-contained file that can be deployed by any standard MSI tool.

  The package is built for x64, because the application is a 64-bit
  program: it belongs in the real Program Files, next to where the
  Inno Setup package puts it, not in Program Files (x86).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="MuktoDwar"
    Language="1033"
    Version="1.1.2"
    Manufacturer="MuktoDwar"
    UpgradeCode="12345678-1234-1234-1234-123456789ABC">
    <Package
      Id="*"
      InstallerVersion="200"
      Compressed="yes"
      InstallScope="perMachine"
      Description="MuktoDwar - local AI gateway for Windows"
      Manufacturer="MuktoDwar"
      Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of MuktoDwar is already installed." />
    <MediaTemplate CabinetTemplate="app{0}.cab" CompressionLevel="high" EmbedCab="yes" />
    <Property Id="ARPPRODUCTICON" Value="muktodwar.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/habibbrox2/MuktoDwar#readme" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/habibbrox2/MuktoDwar" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Icon Id="muktodwar.ico" SourceFile="..\assets\brand\muktodwar.ico" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Feature Id="ProductFeature" Title="MuktoDwar" Level="1" Description="Local AI gateway with an OpenAI-compatible API.">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
      <ComponentGroupRef Id="InstallationMarkerGroup" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="MuktoDwar" />
      </Directory>
      <Directory Id="ProgramMenuFolder" Name="Programs" />
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <!--
    The shortcuts: one in the Start menu and one on the desktop.

    The Start Menu shortcut used to sit in a component under the
    installation folder, which put a useless .lnk next to the executable
    instead of in the Start Menu. Both shortcuts now live where a user
    expects them, and both are removed again when the product is
    uninstalled.

    Neither shortcut names an icon file: the executable carries the
    MuktoDwar icon inside it, and a shortcut that points at an icon file
    that is not next to it would show an empty icon instead.

    Both components are per-user, with their key path under HKCU. That is
    what Windows Installer expects from a shortcut that is not
    advertised, and it is also what puts the desktop shortcut on the
    desktop of the person who installed the program.
  -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="StartMenuShortcut" Guid="9E1B4C77-1A22-4E9B-9B3E-5C0F2A6D8E41">
        <Shortcut
          Id="StartMenuShortcutLink"
          Name="MuktoDwar"
          Description="MuktoDwar - local AI gateway"
          Directory="ProgramMenuFolder"
          Target="[INSTALLFOLDER]muktodwar.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
          Root="HKCU"
          Key="Software\MuktoDwar"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="3F5B9C21-7D4E-4A16-B0C3-6E8F2D5A9B47">
        <Shortcut
          Id="DesktopShortcutLink"
          Name="MuktoDwar"
          Description="MuktoDwar - local AI gateway"
          Target="[INSTALLFOLDER]muktodwar.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
          Root="HKCU"
          Key="Software\MuktoDwar"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="ApplicationShortcuts">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </ComponentGroup>
  </Fragment>

  <!--
    The marker that says MuktoDwar is installed on this machine. It is
    a component of its own, because a component may not mix per-machine
    and per-user data.
  -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallationMarker" Guid="7C4E1D8A-9B25-4F63-A0D7-3E8B5C216D94" Win64="yes">
        <RegistryValue
          Root="HKLM"
          Key="Software\MuktoDwar"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="InstallationMarkerGroup">
      <ComponentRef Id="InstallationMarker" />
    </ComponentGroup>
  </Fragment>
</Wix>
