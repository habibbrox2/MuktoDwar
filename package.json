{
  "name": "mukto-dwar",
  "version": "1.1.3",
  "private": true,
  "description": "MuktoDwar (মুক্তদ্বার) — lightweight, free-only, local AI gateway for Windows with an OpenAI-compatible API.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:sea": "node scripts/build-sea.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build && npm run version:check",
    "brand:build": "node scripts/generate-brand-assets.mjs",
    "sync:models": "node scripts/sync-models-dev.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "site:build": "node scripts/build-site.mjs",
    "site:serve": "node scripts/build-site.mjs --serve"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@types/node": "^26.6.5",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "resedit": "^3.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
